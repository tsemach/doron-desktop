# Defaults to http://localhost:3000 when unset -- leave blank for local dev.
# Set as a repo-level GitHub Actions variable for real installer builds (see
# .github/workflows/release.yml / deploy-desktop.yml).
VITE_BACKEND_URL=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Rust-side (not Vite/frontend) -- read at `cargo build` time via option_env!
# in calendar/oauth.rs, forwarded from this file by src-tauri/build.rs via
# dotenvy::from_path (explicit path, not dotenvy's default directory-walk --
# apps/desktop/src-tauri/.env is a separate, stale/unused file, not this
# one). From the "Desktop app" OAuth client's credentials (Google Cloud
# Console -> APIs & Services -> Credentials). Production builds source these
# from GitHub Actions secrets instead (see release.yml/deploy-desktop.yml),
# not from this file.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
